@namespace Quantum.OfficialPlugins.Calendar.Pages
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using Quantum.OfficialPlugins.Calendar.Application
@using Quantum.OfficialPlugins.Calendar.Domain
@using Quantum.OfficialPlugins.Calendar.Localization
@inject ICalendarApplicationService CalendarService
@inject IStringLocalizer<PluginStrings> L

<PageTitle>@L["待办"] · Quantum</PageTitle>

<section class="tasks-shell">
    <header class="tasks-header">
        <div>
            <p class="eyebrow">@L["TASKS"]</p>
            <h1>@L["待办清单"]</h1>
            <p>@L["把下一步写清楚，然后一次完成一件事。"]</p>
        </div>
        <button type="button" class="primary-button" disabled="@_isBusy" @onclick="BeginCreate">＋ @L["新建待办"]</button>
    </header>

    @if (_errorMessage is not null)
    {
        <div class="error-banner" role="alert">
            <span>@_errorMessage</span>
            <button type="button" @onclick="() => _errorMessage = null">@L["关闭"]</button>
        </div>
    }

    <div class="task-layout" aria-busy="@_isBusy">
        <main class="task-list-card">
            <div class="list-toolbar">
                <div class="filters" role="group" aria-label="@L["筛选待办"]">
                    @foreach (var filter in Enum.GetValues<TaskFilter>())
                    {
                        <button type="button" class="@(_filter == filter ? "active" : null)" @onclick="() => _filter = filter">@FilterLabel(filter)</button>
                    }
                </div>
                <span>@L["{0} 项未完成", OpenCount]</span>
            </div>

            @if (FilteredTasks.Count > 0)
            {
                <div class="task-list">
                    @foreach (var task in FilteredTasks)
                    {
                        <article @key="task.Id" class="task-item @task.Style @(task.IsCompleted ? "completed" : null)">
                            <button type="button"
                                    class="completion-toggle"
                                    aria-label="@(task.IsCompleted ? L["标记为未完成"] : L["标记为已完成"])"
                                    aria-pressed="@task.IsCompleted"
                                    disabled="@_isBusy"
                                    @onclick="() => ToggleCompletedAsync(task)">
                                @(task.IsCompleted ? "✓" : null)
                            </button>
                            <div class="task-content">
                                <h2>@task.Title</h2>
                                <div class="task-date @(IsOverdue(task) ? "overdue" : null)">
                                    <time datetime="@task.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@FormatDeadline(task)</time>
                                    @if (IsOverdue(task))
                                    {
                                        <span>@L["已逾期"]</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(task.Notes))
                                {
                                    <p>@task.Notes</p>
                                }
                            </div>
                            <div class="task-actions">
                                <button type="button" disabled="@_isBusy" @onclick="() => BeginEdit(task)">@L["编辑"]</button>
                                <button type="button" class="danger" disabled="@_isBusy" @onclick="() => DeleteAsync(task.Id)">@L["删除"]</button>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="empty-tasks">
                    <span aria-hidden="true">✓</span>
                    <h2>@L["这里已经清空了"]</h2>
                    <p>@L["没有符合当前筛选条件的待办。"]</p>
                </div>
            }
        </main>

        <aside class="task-editor-card">
            <div class="editor-heading">
                <div>
                    <p class="eyebrow">@(_editingId is null ? L["NEW TASK"] : L["EDIT TASK"])</p>
                    <h2>@(_editingId is null ? L["安排下一步"] : L["调整待办"])</h2>
                </div>
                @if (_editingId is not null)
                {
                    <button type="button" class="close-button" aria-label="@L["取消编辑"]" @onclick="BeginCreate">×</button>
                }
            </div>
            <label>
                <span>@L["标题"]</span>
                <input maxlength="120" placeholder="@L["要做什么？"]" @bind="_draft.Title" />
            </label>
            <div class="form-row">
                <label>
                    <span>@L["截止日期"]</span>
                    <input type="date" @bind="_draft.Date" />
                </label>
                <label>
                    <span>@L["截止时间"]</span>
                    <input type="time" @bind="_draft.Time" />
                </label>
            </div>
            <label>
                <span>@L["备注"]</span>
                <textarea maxlength="1000" rows="5" placeholder="@L["补充一些细节…"]" @bind="_draft.Notes"></textarea>
            </label>
            <fieldset class="color-picker">
                <legend>@L["颜色"]</legend>
                @foreach (var style in Styles)
                {
                    <button type="button"
                            class="swatch @style @(_draft.Style == style ? "selected" : null)"
                            aria-label="@style"
                            aria-pressed="@(_draft.Style == style)"
                            @onclick="() => _draft.Style = style"></button>
                }
            </fieldset>
            <button type="button" class="primary-button save-button" disabled="@(_isBusy || string.IsNullOrWhiteSpace(_draft.Title))" @onclick="SaveAsync">
                @(_editingId is null ? L["添加待办"] : L["保存修改"])
            </button>
        </aside>
    </div>
</section>

@code {
    private static readonly string[] Styles = ["violet", "blue", "coral", "green"];
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private IReadOnlyList<CalendarEntryDetails> _tasks = [];
    private TaskFilter _filter = TaskFilter.Open;
    private TaskDraft _draft = TaskDraft.Create(DateOnly.FromDateTime(DateTime.Today));
    private Guid? _editingId;
    private bool _isBusy;
    private string? _errorMessage;

    private int OpenCount => _tasks.Count(task => !task.IsCompleted);

    private IReadOnlyList<CalendarEntryDetails> FilteredTasks =>
        [.. _tasks.Where(task => _filter switch
        {
            TaskFilter.Open => !task.IsCompleted,
            TaskFilter.Completed => task.IsCompleted,
            _ => true
        })];

    protected override Task OnInitializedAsync() => LoadTasksAsync();

    private void BeginCreate()
    {
        _editingId = null;
        _draft = TaskDraft.Create(_today);
        _errorMessage = null;
    }

    private void BeginEdit(CalendarEntryDetails task)
    {
        _editingId = task.Id;
        _draft = new TaskDraft
        {
            Title = task.Title,
            Notes = task.Notes,
            Date = task.Date,
            Time = task.StartTime,
            Style = task.Style
        };
        _errorMessage = null;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft.Title))
        {
            return;
        }

        await ExecuteAsync(async () =>
        {
            var request = new SaveCalendarEntryRequest(
                _draft.Title,
                _draft.Notes,
                CalendarEntryKind.Task,
                _draft.Date,
                _draft.Time,
                null,
                _draft.Style);
            if (_editingId is { } id)
            {
                await CalendarService.UpdateAsync(id, request);
            }
            else
            {
                await CalendarService.CreateAsync(request);
            }

            BeginCreate();
            await LoadTasksCoreAsync();
        });
    }

    private Task ToggleCompletedAsync(CalendarEntryDetails task)
        => ExecuteAsync(async () =>
        {
            await CalendarService.SetCompletedAsync(task.Id, !task.IsCompleted);
            await LoadTasksCoreAsync();
        });

    private Task DeleteAsync(Guid id)
        => ExecuteAsync(async () =>
        {
            await CalendarService.DeleteAsync(id);
            if (_editingId == id)
            {
                BeginCreate();
            }

            await LoadTasksCoreAsync();
        });

    private Task LoadTasksAsync() => ExecuteAsync(LoadTasksCoreAsync);

    private async Task LoadTasksCoreAsync()
        => _tasks = await CalendarService.ListTasksAsync();

    private async Task ExecuteAsync(Func<Task> action)
    {
        _isBusy = true;
        _errorMessage = null;
        try
        {
            await action();
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private bool IsOverdue(CalendarEntryDetails task)
        => !task.IsCompleted && (task.Date < _today || (task.Date == _today && task.StartTime < TimeOnly.FromDateTime(DateTime.Now)));

    private static string FormatDeadline(CalendarEntryDetails task)
        => $"{task.Date.ToDateTime(task.StartTime):D} · {task.StartTime:HH:mm}";

    private string FilterLabel(TaskFilter filter) => filter switch
    {
        TaskFilter.Open => L["未完成"],
        TaskFilter.Completed => L["已完成"],
        _ => L["全部"]
    };

    private enum TaskFilter
    {
        Open,
        Completed,
        All
    }

    private sealed class TaskDraft
    {
        public string Title { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
        public DateOnly Date { get; set; }
        public TimeOnly Time { get; set; }
        public string Style { get; set; } = "violet";

        public static TaskDraft Create(DateOnly date) => new() { Date = date, Time = new TimeOnly(18, 0) };
    }
}
