<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Quantum.CalendarPlugin</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Quantum.Plugin.Abstraction" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="NOF.Abstraction" />
    <PackageReference Include="NOF.Application" />
    <PackageReference Include="NOF.Contract" />
    <PackageReference Include="NOF.Domain" />
    <PackageReference Include="NOF.Infrastructure" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="migrations\**\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyCalendarScopedCssBundle"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <CalendarScopedCssBundleSource>$(IntermediateOutputPath)scopedcss\projectbundle\$(PackageId).bundle.scp.css</CalendarScopedCssBundleSource>
      <CalendarScopedCssBundleTarget>$(TargetDir)wwwroot\$(PackageId).bundle.scp.css</CalendarScopedCssBundleTarget>
    </PropertyGroup>
    <Error Condition="!Exists('$(CalendarScopedCssBundleSource)')"
           Text="The Calendar scoped CSS bundle was not generated: $(CalendarScopedCssBundleSource)" />
    <MakeDir Directories="$(TargetDir)wwwroot" />
    <Copy SourceFiles="$(CalendarScopedCssBundleSource)"
          DestinationFiles="$(CalendarScopedCssBundleTarget)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish does not include the custom Build copy in its static asset manifest. -->
  <Target Name="PublishCalendarScopedCssBundle" BeforeTargets="ComputeFilesToPublish">
    <PropertyGroup>
      <ScopedCssPublishSource>$(IntermediateOutputPath)scopedcss/projectbundle/$(PackageId).bundle.scp.css</ScopedCssPublishSource>
    </PropertyGroup>
    <Error Condition="!Exists('$(ScopedCssPublishSource)')"
           Text="The Calendar scoped CSS bundle is required for publishing: $(ScopedCssPublishSource)" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ScopedCssPublishSource)"
                             RelativePath="wwwroot/$(PackageId).bundle.scp.css"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
