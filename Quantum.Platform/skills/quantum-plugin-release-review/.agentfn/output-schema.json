{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "summary", "reviewedFiles", "checksPerformed", "findings"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["approve", "reject", "manual_review"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "reviewedFiles": {
      "type": "integer",
      "minimum": 0
    },
    "checksPerformed": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"]
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "maxLength": 80
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "path": {
            "type": ["string", "null"],
            "maxLength": 500
          },
          "evidence": {
            "type": ["string", "null"],
            "maxLength": 1000
          }
        }
      }
    }
  }
}
