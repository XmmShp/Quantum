<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.1</Version>
    <PackageId>Quantum.Mobile.Protocol</PackageId>
    <Authors>Quantum contributors</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/XmmShp/Quantum.Sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Data-only mobile UI and authenticated polling protocol for Quantum.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\..\docs\mobile-ui.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
