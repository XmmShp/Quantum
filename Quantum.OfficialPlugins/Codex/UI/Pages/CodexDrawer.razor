@using NOF.Contract
@using Quantum.OfficialPlugins.Codex
@namespace Quantum.OfficialPlugins.Codex.UI.Pages
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using Quantum.OfficialPlugins.Codex.Application
@using Quantum.OfficialPlugins.Codex.UI.Localization
@implements IDisposable
@inject IStringLocalizer<PluginStrings> L
@inject NavigationManager Navigation

@if (!IsOnCodexPage)
{
    <div class="floating-host" @onkeydown="HandleDrawerKeyDown">
        <button type="button"
                class="drawer-launcher"
                aria-label="@L["Open Codex"]"
                aria-expanded="@_isOpen"
                aria-controls="quantum-codex-drawer"
                @onclick="OpenDrawer">
            <span aria-hidden="true">✦</span>
            <span class="launcher-label">Codex</span>
        </button>

        @if (_isOpen)
        {
            <button type="button" class="drawer-backdrop" aria-label="@L["Close"]" @onclick="CloseDrawer"></button>
            <aside id="quantum-codex-drawer" class="drawer-panel" role="dialog" aria-modal="true" aria-label="Codex">
                <header class="drawer-header">
                    <div><span aria-hidden="true">✦</span><strong>Codex</strong></div>
                    <a href="/plugins/codex" aria-label="@L["Open Codex on its full page"]" title="@L["Open full page"]"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6m0-6L10 14M10 4H4v16h16v-6" /></svg></a>
                    <button type="button" autofocus aria-label="@L["Close Codex"]" @onclick="CloseDrawer">×</button>
                </header>

                <section class="drawer-shell">
                    @if (_snapshot.ErrorMessage is not null || _localError is not null)
                    {
                        <div class="drawer-error" role="alert">
                            <span>@L[_localError ?? _snapshot.ErrorMessage!]</span>
                            <button type="button" aria-label="@L["Close"]" @onclick="() => _localError = null">×</button>
                        </div>
                    }

                    @if (_snapshot.ConnectionState != CodexConnectionState.Connected)
                    {
                        <section class="drawer-connect">
                            <div class="drawer-mark" aria-hidden="true">✦</div>
                            <div>
                                <h1>@L["Connect local Codex"]</h1>
                                <p>@L["Automatically connects to local Codex. Connection errors appear here; you can retry."]</p>
                            </div>
                            <label>
                                <span>@L["Model"]</span>
                                <select @bind="_selectedModel" disabled="@IsConnecting">
                                    @foreach (var model in _snapshot.Models)
                                    {
                                        <option value="@model.Id">@model.DisplayName</option>
                                    }
                                </select>
                            </label>
                            <label>
                                <span>@L["Working directory"]</span>
                                <input @bind="_workingDirectory" disabled="@IsConnecting" />
                            </label>
                            <button type="button" class="drawer-primary" disabled="@IsConnecting" @onclick="ConnectAsync">
                                @(IsConnecting ? L["Connecting"] : L[_snapshot.ConnectionState == CodexConnectionState.Failed ? "Retry connection" : "Connect"])
                            </button>
                        </section>
                    }
                    else
                    {
                        <header class="drawer-toolbar">
                            <div class="drawer-state">
                                <span class="status-dot"></span>
                                <strong>@L["Connected"]</strong>
                                <small>@L["{0} Quantum tools", _snapshot.ToolCount]</small>
                            </div>
                            <select aria-label="@L["Model"]" value="@_selectedModel" disabled="@_snapshot.IsBusy" @onchange="ChangeModelAsync">
                                @foreach (var model in _snapshot.Models)
                                {
                                    <option value="@model.Id">@model.DisplayName</option>
                                }
                            </select>
                            <button type="button" title="@L["New conversation"]" aria-label="@L["New conversation"]" disabled="@_snapshot.IsBusy" @onclick="NewThreadAsync"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button>
                        </header>

                        <div class="drawer-conversation" aria-live="polite" aria-busy="@_snapshot.IsBusy">
                            @if (!_snapshot.Messages.Any(message => message.Role != CodexMessageRole.System))
                            {
                                <div class="drawer-empty">
                                    <span aria-hidden="true">✦</span>
                                    <h1>@L["Start a conversation"]</h1>
                                    <p>@L["Ask Codex to inspect your calendar, create a task, or use RPCs published by other plugins."]</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var message in _snapshot.Messages)
                                {
                                    <article @key="message.Id" class="drawer-message @message.Role.ToString().ToLowerInvariant()">
                                        <span>@L[message.Role.ToString()]</span>
                                        <div>
                                            @message.Text
                                            @if (message.IsTranscribing) { <small class="message-attachment" role="status">@L["Transcribing voice…"]</small> }
                                            @foreach (var attachment in message.Attachments)
                                            {
                                                <small class="message-attachment">📎 @attachment.Name</small>
                                            }
                                            @if (message.IsStreaming)
                                            {
                                                <i class="drawer-cursor">▍</i>
                                            }
                                        </div>
                                    </article>
                                }
                            }
                        </div>

                        <footer class="drawer-composer">
                            <CodexMediaInput @ref="_mediaInput" Disabled="@_sending" Value="@_attachments" Changed="@(files => _attachments = files)" RecordingChanged="@(value => _recording = value)" />
                            <textarea rows="3"
                                      aria-label="@L["Message Codex…"]"
                                      placeholder="@L["Message Codex…"]"
                                      disabled="@_sending"
                                      @bind="_prompt"
                                      @onkeydown="HandleComposerKeyDownAsync"></textarea>
                            <button type="button" class="drawer-primary" disabled="@(!CanSend)" @onclick="SendAsync">@L["Send"]<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6" /></svg></button>
                        </footer>
                    }
                </section>
            </aside>
        }
    </div>
}
