<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Fixtures/OptionalFrameworkPackage/OptionalFrameworkPackage.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../../mobile/Quantum.Mobile/MobileFeedback.cs" Link="Mobile/MobileFeedback.cs" />
    <Compile Include="../../../mobile/Quantum.Mobile/MobileNavigationState.cs" Link="Mobile/MobileNavigationState.cs" />
    <Compile Include="../../../mobile/Quantum.Mobile/MobileDesktopSelection.cs" Link="Mobile/MobileDesktopSelection.cs" />
    <Compile Include="../../../mobile/Quantum.Mobile/Debugging/*.cs" Link="Mobile/Debugging/%(Filename)%(Extension)" />
    <ProjectReference Include="..\..\src\Quantum\Quantum.csproj" />
    <ProjectReference Include="..\..\..\samples\Quantum.ExampleDependentPlugin\Quantum.ExampleDependentPlugin.csproj" />
    <ProjectReference Include="..\..\..\samples\Quantum.ExamplePlugin\Quantum.ExamplePlugin.csproj" />
  </ItemGroup>
  <Target Name="CopyOptionalFrameworkFixture" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../Fixtures/OptionalFrameworkPackage/bin/$(Configuration)/net10.0/System.Quantum.Optional.dll"
          DestinationFolder="$(TargetDir)PrivateOptional" />
  </Target>
</Project>
