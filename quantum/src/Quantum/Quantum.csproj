<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>
    <UseMaui Condition="'$(TargetFramework)' != 'net10.0'">true</UseMaui>
    <SingleProject Condition="'$(TargetFramework)' != 'net10.0'">true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Quantum</ApplicationTitle>
    <ApplicationId>io.quantum.desktop</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <MtouchLink Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">None</MtouchLink>
    <UseInterpreter Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">true</UseInterpreter>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' And '$(Configuration)' == 'Debug'">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' And '$(Configuration)' == 'Debug'">true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#6D5DFB" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#171528" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\sdk\dotnet\src\Quantum.Plugin.Abstraction\Quantum.Plugin.Abstraction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="NOF.Abstraction" />
    <PackageReference Include="NOF.Application" />
    <PackageReference Include="NOF.Contract" />
    <PackageReference Include="NOF.Domain" />
    <PackageReference Include="NOF.Infrastructure" />
    <PackageReference Include="NOF.Infrastructure.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="NOF.Hosting.Maui" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="App.cs;MainPage.cs;MauiProgram.cs;PluginBlazorWebView.cs;PluginLifecycleInitializationStep.cs;Platforms\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Quantum.Tests" />
  </ItemGroup>

  <Target Name="BuildExamplePlugins"
          BeforeTargets="Build"
          Condition="'$(Configuration)' == 'Debug' And '$(TargetFramework)' != '' And '$(TargetFramework)' != 'net10.0'">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\..\..\samples\Quantum.ExamplePlugin\Quantum.ExamplePlugin.csproj;$(MSBuildProjectDirectory)\..\..\..\samples\Quantum.ExampleCalendarPlugin\Quantum.ExampleCalendarPlugin.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0"
             RemoveProperties="RuntimeIdentifier;TargetFrameworks" />
  </Target>

  <Target Name="StageExamplePlugin"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' And '$(TargetFramework)' != '' And '$(TargetFramework)' != 'net10.0'">
    <PropertyGroup>
      <ExamplePluginOutput>$(MSBuildProjectDirectory)\..\..\..\samples\Quantum.ExamplePlugin\bin\$(Configuration)\net10.0</ExamplePluginOutput>
      <ExamplePluginTarget>$(TargetDir)Modules\quantum.plugin.example</ExamplePluginTarget>
    </PropertyGroup>
    <ItemGroup>
      <ExamplePluginBinary Include="$(ExamplePluginOutput)\Quantum.ExamplePlugin.dll" />
      <ExamplePluginBinary Include="$(ExamplePluginOutput)\Quantum.ExamplePlugin.pdb" Condition="Exists('$(ExamplePluginOutput)\Quantum.ExamplePlugin.pdb')" />
      <ExamplePluginBinary Include="$(ExamplePluginOutput)\plugin.json" />
      <ExamplePluginAsset Include="$(ExamplePluginOutput)\wwwroot\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(ExamplePluginTarget)\wwwroot" />
    <Copy SourceFiles="@(ExamplePluginBinary)" DestinationFolder="$(ExamplePluginTarget)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ExamplePluginAsset)"
          DestinationFolder="$(ExamplePluginTarget)\wwwroot\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="StageExampleCalendarPlugin"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' And '$(TargetFramework)' != '' And '$(TargetFramework)' != 'net10.0'">
    <PropertyGroup>
      <ExampleCalendarPluginOutput>$(MSBuildProjectDirectory)\..\..\..\samples\Quantum.ExampleCalendarPlugin\bin\$(Configuration)\net10.0</ExampleCalendarPluginOutput>
      <ExampleCalendarPluginTarget>$(TargetDir)Modules\quantum.plugin.example-calendar</ExampleCalendarPluginTarget>
    </PropertyGroup>
    <ItemGroup>
      <ExampleCalendarPluginBinary Include="$(ExampleCalendarPluginOutput)\Quantum.ExampleCalendarPlugin.dll" />
      <ExampleCalendarPluginBinary Include="$(ExampleCalendarPluginOutput)\Quantum.ExampleCalendarPlugin.pdb" Condition="Exists('$(ExampleCalendarPluginOutput)\Quantum.ExampleCalendarPlugin.pdb')" />
      <ExampleCalendarPluginBinary Include="$(ExampleCalendarPluginOutput)\plugin.json" />
      <ExampleCalendarPluginAsset Include="$(ExampleCalendarPluginOutput)\wwwroot\**\*" />
      <ExampleCalendarPluginMigration Include="$(ExampleCalendarPluginOutput)\migrations\**\*.sql" />
    </ItemGroup>
    <MakeDir Directories="$(ExampleCalendarPluginTarget)\wwwroot;$(ExampleCalendarPluginTarget)\migrations" />
    <Copy SourceFiles="@(ExampleCalendarPluginBinary)" DestinationFolder="$(ExampleCalendarPluginTarget)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ExampleCalendarPluginAsset)"
          DestinationFolder="$(ExampleCalendarPluginTarget)\wwwroot\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ExampleCalendarPluginMigration)"
          DestinationFolder="$(ExampleCalendarPluginTarget)\migrations\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="StageExampleWebPlugin"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' And '$(TargetFramework)' != '' And '$(TargetFramework)' != 'net10.0' And Exists('$(MSBuildProjectDirectory)\..\..\..\samples\Quantum.ExampleWebPlugin\wwwroot\dist\plugin.js')">
    <PropertyGroup>
      <ExampleWebPluginRoot>$(MSBuildProjectDirectory)\..\..\..\samples\Quantum.ExampleWebPlugin</ExampleWebPluginRoot>
      <ExampleWebPluginTarget>$(TargetDir)Modules\quantum.plugin.example-web</ExampleWebPluginTarget>
    </PropertyGroup>
    <ItemGroup>
      <ExampleWebPluginAsset Include="$(ExampleWebPluginRoot)\wwwroot\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(ExampleWebPluginTarget)\wwwroot" />
    <Copy SourceFiles="$(ExampleWebPluginRoot)\plugin.json"
          DestinationFolder="$(ExampleWebPluginTarget)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ExampleWebPluginAsset)"
          DestinationFolder="$(ExampleWebPluginTarget)\wwwroot\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
