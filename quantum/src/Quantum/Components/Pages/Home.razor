@page "/"
@implements IDisposable
@inject PluginCatalog PluginCatalog
@inject IPluginRuntimeManager PluginRuntimeManager

<PageTitle>Quantum</PageTitle>

<section class="hero">
    <p class="eyebrow">QUANTUM</p>
    <h1>你的本地能力，<br />都在一个工作台里。</h1>
    <p class="hero-copy">基于 .NET 10、NOF 与 MAUI Blazor Hybrid 的本地优先插件平台。</p>
</section>

<section class="metric-grid" aria-label="运行概览">
    <article class="metric-card accent-card">
        <span>已加载插件</span>
        <strong>@PluginCatalog.Plugins.Count</strong>
        <small>独立 AssemblyLoadContext</small>
    </article>
    <article class="metric-card">
        <span>注册页面</span>
        <strong>@PluginCatalog.Routes.Count</strong>
        <small>由 manifest 动态注入</small>
    </article>
    <article class="metric-card">
        <span>启动异常</span>
        <strong>@PluginCatalog.Failures.Count</strong>
        <small>单个插件失败不阻塞宿主</small>
    </article>
</section>

<section class="section-block">
    <div class="section-heading">
        <div>
            <p class="eyebrow">RUNTIME</p>
            <h2>插件运行状态</h2>
        </div>
        <button class="secondary-button"
                disabled="@IsBusy"
                @onclick="RefreshAsync">
            重新扫描 Modules
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_operationMessage))
    {
        <div class="operation-message @(_operationSucceeded ? "success" : "error")">
            @_operationMessage
        </div>
    }

    @if (PluginCatalog.Plugins.Count == 0)
    {
        <div class="empty-card">
            <span class="empty-symbol">＋</span>
            <div>
                <strong>尚未发现插件</strong>
                <p>将插件目录放入 Modules，或通过 QUANTUM_MODULES_PATH 指定开发目录。</p>
            </div>
        </div>
    }
    else
    {
        <div class="plugin-list">
            @foreach (var plugin in PluginCatalog.Plugins)
            {
                <article class="plugin-row">
                    <span class="plugin-avatar">@plugin.Manifest.Id.Value[0].ToString().ToUpperInvariant()</span>
                    <div class="plugin-meta">
                        <strong>@plugin.Manifest.Id</strong>
                        <span>v@(plugin.Manifest.Version) · @plugin.Routes.Count 个页面</span>
                    </div>
                    <span class="healthy-pill">运行中</span>
                    <div class="plugin-actions">
                        <button disabled="@IsBusy"
                                @onclick="() => ReloadAsync(plugin.Manifest.Id.Value)">
                            热升级
                        </button>
                        <button class="danger"
                                disabled="@IsBusy"
                                @onclick="() => PrepareUnload(plugin.Manifest.Id.Value)">
                            卸载
                        </button>
                    </div>
                </article>
            }
        </div>
    }
</section>

@if (_pendingUnloadImpact is { } unloadImpact)
{
    <div class="dialog-backdrop">
        <section class="unload-dialog"
                 role="alertdialog"
                 aria-modal="true"
                 aria-labelledby="unload-dialog-title">
            <p class="eyebrow">UNLOAD PLUGIN</p>
            <h2 id="unload-dialog-title">确认卸载 @unloadImpact.PluginId？</h2>
            @if (unloadImpact.DependentPluginIds.Count == 0)
            {
                <p>该插件没有下游强依赖插件。</p>
            }
            else
            {
                <p>以下直接或传递依赖插件会被一起卸载：</p>
                <ul>
                    @foreach (var dependentPluginId in unloadImpact.DependentPluginIds)
                    {
                        <li>@dependentPluginId</li>
                    }
                </ul>
            }
            <p class="dialog-note">Modules 中的源文件不会被删除，可通过重新扫描恢复。</p>
            <div class="dialog-actions">
                <button type="button" class="secondary-button" @onclick="CancelUnload">
                    取消
                </button>
                <button type="button" class="danger-button" @onclick="ConfirmUnloadAsync">
                    确认卸载
                </button>
            </div>
        </section>
    </div>
}

@if (PluginCatalog.Failures.Count > 0)
{
    <section class="section-block failures">
        <div class="section-heading">
            <div>
                <p class="eyebrow">ATTENTION</p>
                <h2>未加载的插件</h2>
            </div>
        </div>
        @foreach (var failure in PluginCatalog.Failures)
        {
            <div class="failure-row">
                <strong>@(failure.PluginId?.Value ?? "未知插件")</strong>
                <span>@failure.Reason</span>
            </div>
        }
    </section>
}

@code {
    private string? _busyPluginId;
    private string? _operationMessage;
    private bool _operationSucceeded;
    private PluginUnloadImpact? _pendingUnloadImpact;

    private bool IsBusy => _busyPluginId is not null || _pendingUnloadImpact is not null;

    protected override void OnInitialized()
    {
        PluginCatalog.Changed += OnCatalogChanged;
    }

    public void Dispose()
    {
        PluginCatalog.Changed -= OnCatalogChanged;
    }

    private Task ReloadAsync(string pluginId)
        => RunOperationAsync(pluginId, () => PluginRuntimeManager.ReloadAsync(pluginId));

    private void PrepareUnload(string pluginId)
    {
        if (IsBusy)
        {
            return;
        }

        try
        {
            _pendingUnloadImpact = PluginRuntimeManager.GetUnloadImpact(pluginId);
            _operationMessage = null;
        }
        catch (Exception exception)
        {
            _operationSucceeded = false;
            _operationMessage = $"无法准备卸载：{exception.Message}";
        }
    }

    private void CancelUnload()
        => _pendingUnloadImpact = null;

    private async Task ConfirmUnloadAsync()
    {
        var impact = _pendingUnloadImpact;
        if (impact is null || _busyPluginId is not null)
        {
            return;
        }

        _pendingUnloadImpact = null;
        await RunOperationAsync(
            impact.PluginId,
            () => PluginRuntimeManager.UnloadAsync(impact.PluginId, impact.CatalogRevision));
    }

    private Task RefreshAsync()
        => RunOperationAsync("*", () => PluginRuntimeManager.RefreshAsync());

    private async Task RunOperationAsync(
        string operationId,
        Func<Task<PluginOperationResult>> operation)
    {
        if (IsBusy)
        {
            return;
        }

        _busyPluginId = operationId;
        _operationMessage = null;
        try
        {
            var result = await operation();
            _operationSucceeded = result.Succeeded;
            _operationMessage = result.Message;
        }
        catch (Exception exception)
        {
            _operationSucceeded = false;
            _operationMessage = $"插件操作失败：{exception.Message}";
        }
        finally
        {
            _busyPluginId = null;
        }
    }

    private void OnCatalogChanged(object? sender, EventArgs eventArgs)
    {
        _ = InvokeAsync(StateHasChanged);
    }
}
