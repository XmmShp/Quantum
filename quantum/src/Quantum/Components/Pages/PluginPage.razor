@page "/{**PluginPath}"
@implements IDisposable
@inject PluginCatalog PluginCatalog
@inject NavigationManager NavigationManager

@if (_route is null)
{
    <div class="empty-state">
        <p class="eyebrow">PLUGIN ROUTE</p>
        <h1>插件页面不存在</h1>
        <p>没有插件为 <code>@CurrentPath</code> 注册页面。</p>
        <a class="primary-button" href="/">返回首页</a>
    </div>
}
else
{
    <DynamicComponent @key="_plugin?.RuntimeId" Type="_route.ComponentType" />
}

@code {
    [Parameter]
    public string? PluginPath { get; set; }

    private PluginRouteRegistration? _route;
    private LoadedPlugin? _plugin;

    private string CurrentPath => $"/{PluginPath ?? string.Empty}".TrimEnd('/');

    protected override void OnInitialized()
    {
        PluginCatalog.Changed += OnCatalogChanged;
    }

    protected override void OnParametersSet()
    {
        ResolveRoute();
    }

    public void Dispose()
    {
        PluginCatalog.Changed -= OnCatalogChanged;
    }

    private void ResolveRoute()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var path = $"/{relativePath.Split('?', '#')[0]}";
        _route = PluginCatalog.FindRoute(path);
        _plugin = _route is null ? null : PluginCatalog.FindPlugin(_route.PluginId.Value);
    }

    private void OnCatalogChanged(object? sender, EventArgs eventArgs)
    {
        _ = InvokeAsync(() =>
        {
            ResolveRoute();
            StateHasChanged();
        });
    }
}
