@implements IAsyncDisposable
@using Microsoft.Extensions.Logging
@inject IJSRuntime JavaScript
@inject ILogger<WebPluginView> Logger
@inject IStringLocalizer<AppStrings> L
@inject CultureService CultureService

<div class="web-plugin-view" @ref="_hostElement">
    @if (!string.IsNullOrWhiteSpace(_failureMessage))
    {
        <div class="empty-state">
            <p class="eyebrow">@L["WEB PLUGIN ERROR"]</p>
            <h1>@L["插件页面启动失败"]</h1>
            <p>@_failureMessage</p>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public LoadedPlugin Plugin { get; set; } = null!;

    [Parameter, EditorRequired]
    public PluginRouteRegistration Route { get; set; } = null!;

    [CascadingParameter(Name = "CultureName")]
    public string CultureName { get; set; } = CultureService.EnglishCultureName;

    private ElementReference _hostElement;
    private string? _attachedKey;
    private string? _attemptedKey;
    private string? _failureMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var key = $"{Plugin.RuntimeId:N}:{Route.Definition.Path}:{CultureName}";
        if (string.Equals(_attemptedKey, key, StringComparison.Ordinal))
        {
            return;
        }

        _attemptedKey = key;
        try
        {
            if (_attachedKey is not null)
            {
                await JavaScript.InvokeVoidAsync(
                    "quantum.plugins.detachWebPlugin",
                    (string)Plugin.Manifest.Id,
                    _hostElement);
                _attachedKey = null;
            }

            await JavaScript.InvokeVoidAsync(
                "quantum.plugins.attachWebPlugin",
                (string)Plugin.Manifest.Id,
                _hostElement,
                new
                {
                    Route = new
                    {
                        Route.Definition.Path,
                        Route.Definition.View,
                        Title = Route.Definition.GetTitle(CultureService.CurrentCulture)
                    },
                    Locale = new
                    {
                        CultureName = CultureService.CurrentCulture.Name,
                        LanguageName = CultureService.CurrentCulture.TwoLetterISOLanguageName,
                        TextDirection = CultureService.TextDirection
                    }
            });
            _attachedKey = key;
            _failureMessage = null;
            Logger.LogInformation(
                "Mounted Web plugin {PluginId} runtime {RuntimeId} at route {PluginRoute}.",
                (string)Plugin.Manifest.Id,
                Plugin.RuntimeId,
                Route.Definition.Path);
        }
        catch (Exception exception) when (exception is not OutOfMemoryException)
        {
            _failureMessage = exception.Message;
            Logger.LogError(
                exception,
                "Could not mount Web plugin view for {PluginId}.",
                (string)Plugin.Manifest.Id);
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_attachedKey is null)
        {
            return;
        }

        try
        {
            await JavaScript.InvokeVoidAsync(
                "quantum.plugins.detachWebPlugin",
                (string)Plugin.Manifest.Id,
                _hostElement);
        }
        catch (Exception exception) when (exception is JSException or TaskCanceledException)
        {
            Logger.LogDebug(
                exception,
                "Could not detach Web plugin view for {PluginId} during disposal.",
                (string)Plugin.Manifest.Id);
        }
    }
}
