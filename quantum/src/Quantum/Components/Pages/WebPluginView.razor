@implements IAsyncDisposable
@using Microsoft.Extensions.Logging
@inject IJSRuntime JavaScript
@inject ILogger<WebPluginView> Logger

<div class="web-plugin-view" @ref="_hostElement">
    @if (!string.IsNullOrWhiteSpace(_failureMessage))
    {
        <div class="empty-state">
            <p class="eyebrow">WEB PLUGIN ERROR</p>
            <h1>插件页面启动失败</h1>
            <p>@_failureMessage</p>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public LoadedPlugin Plugin { get; set; } = null!;

    [Parameter, EditorRequired]
    public PluginRouteRegistration Route { get; set; } = null!;

    private ElementReference _hostElement;
    private string? _attachedKey;
    private string? _attemptedKey;
    private string? _failureMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var key = $"{Plugin.RuntimeId:N}:{Route.Definition.Path}";
        if (string.Equals(_attemptedKey, key, StringComparison.Ordinal))
        {
            return;
        }

        _attemptedKey = key;
        try
        {
            if (_attachedKey is not null)
            {
                await JavaScript.InvokeVoidAsync(
                    "quantum.plugins.detachWebPlugin",
                    Plugin.Manifest.Id.Value,
                    _hostElement);
                _attachedKey = null;
            }

            await JavaScript.InvokeVoidAsync(
                "quantum.plugins.attachWebPlugin",
                Plugin.Manifest.Id.Value,
                _hostElement,
                new
                {
                    Route.Definition.Path,
                    Route.Definition.View,
                    Route.Definition.Title
            });
            _attachedKey = key;
            _failureMessage = null;
            Logger.LogInformation(
                "Mounted Web plugin {PluginId} runtime {RuntimeId} at route {PluginRoute}.",
                Plugin.Manifest.Id.Value,
                Plugin.RuntimeId,
                Route.Definition.Path);
        }
        catch (Exception exception) when (exception is not OutOfMemoryException)
        {
            _failureMessage = exception.Message;
            Logger.LogError(
                exception,
                "Could not mount Web plugin view for {PluginId}.",
                Plugin.Manifest.Id.Value);
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_attachedKey is null)
        {
            return;
        }

        try
        {
            await JavaScript.InvokeVoidAsync(
                "quantum.plugins.detachWebPlugin",
                Plugin.Manifest.Id.Value,
                _hostElement);
        }
        catch (Exception exception) when (exception is JSException or TaskCanceledException)
        {
            Logger.LogDebug(
                exception,
                "Could not detach Web plugin view for {PluginId} during disposal.",
                Plugin.Manifest.Id.Value);
        }
    }
}
