@page "/mobile"
@implements IDisposable
@using Quantum.Mobile
@using Quantum.Marketplace
@inject MobileDesktopBridge Bridge
@inject PluginCatalog Catalog
@inject QuantumMarketplaceSession Session
@inject IQuantumMarketplaceClient Marketplace
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["MobileAccess"]</PageTitle>
<section class="settings-page">
    <h1>@L["MobileAccess"]</h1>
    <p>@L["MobileAccessDescription"]</p>
    @if (!Session.IsAuthenticated)
    {
        <p><a href="/marketplace">@L["MobileSignInFirst"]</a></p>
    }
    else
    {
        <p role="status">@Session.User?.Username · @L[Bridge.Status == "Connected" ? "MobileConnected" : "MobileConnecting"]</p>
        <h2>@L["MobileSharedPages"]</h2>
        <ul>
            @foreach (var page in Catalog.Plugins.Where(p => p.RpcRuntime?.IsActive != false).SelectMany(p => p.MobilePages.Snapshot()))
            {
                <li>@(page.Title)</li>
            }
        </ul>
        <p>@L["MobileSameAccountHint"]</p>
    }
</section>

@code {
    protected override void OnInitialized()
    {
        Bridge.Changed += Changed;
        Session.Changed += Changed;
        Catalog.Changed += CatalogChanged;
        Bridge.Initialize(Marketplace);
    }
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    private void CatalogChanged(object? sender, EventArgs e) => Changed();
    public void Dispose() { Bridge.Changed -= Changed; Session.Changed -= Changed; Catalog.Changed -= CatalogChanged; }
}
