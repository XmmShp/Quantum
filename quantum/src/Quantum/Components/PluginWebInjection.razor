@inject PluginCatalog PluginCatalog
@inject IJSRuntime JavaScript
@implements IDisposable

@code {
    private long _appliedRevision = -1;

    protected override void OnInitialized()
    {
        PluginCatalog.Changed += OnCatalogChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var revision = PluginCatalog.Revision;
        if (_appliedRevision == revision)
        {
            return;
        }

        var contributions = PluginCatalog.Plugins.Select(plugin => new
        {
            PluginId = plugin.Manifest.Id.Value,
            plugin.Manifest.Web.Head,
            plugin.Manifest.Web.PostBlazor
        }).ToArray();

        await JavaScript.InvokeVoidAsync("quantum.plugins.replaceContributions", contributions);
        _appliedRevision = revision;
    }

    public void Dispose()
    {
        PluginCatalog.Changed -= OnCatalogChanged;
    }

    private void OnCatalogChanged(object? sender, EventArgs eventArgs)
    {
        _ = InvokeAsync(StateHasChanged);
    }
}
