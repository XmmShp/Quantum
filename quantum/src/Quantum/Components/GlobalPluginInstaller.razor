@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject IPluginRuntimeManager PluginRuntimeManager
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<AppStrings> L

<div class="global-install-surface">
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>

    <div @ref="_dropOverlay" class="global-plugin-drop-overlay" aria-hidden="true">
        <InputFile @key="_fileInputKey"
                   @ref="_packageInput"
                   class="global-plugin-drop-input"
                   accept=".zip,application/zip,application/x-zip-compressed"
                   disabled="@_isProcessing"
                   aria-label="@L["DropToInstallThePluginBundle"]"
                   OnChange="PrepareInstallAsync" />
        <div class="global-drop-prompt">
            <span class="global-drop-icon">⇩</span>
            <p class="eyebrow">@L["INSTALLPLUGINS"]</p>
            <strong>@(_isProcessing ? L["ProcessingPluginPackage"] : L["DropToScanThePluginBundle"])</strong>
        </div>
    </div>

    @if (_pendingPreview is { } preview)
    {
        <div class="dialog-backdrop global-install-dialog-backdrop">
            <section class="unload-dialog install-dialog"
                     role="alertdialog"
                     aria-modal="true"
                     aria-labelledby="install-dialog-title">
                <p class="eyebrow">@L["INSTALLPLUGINS"]</p>
                <h2 id="install-dialog-title">
                    @(preview.CanInstall ? GetInstallHeading(preview.InstallCount) : L["ThisPluginPackageCannotBeInstalled"])
                </h2>
                <p class="dialog-note">@preview.ArchiveFileName</p>

                @if (preview.Plugins.Count > 0)
                {
                    <ul class="install-preview-list">
                        @foreach (var plugin in preview.Plugins)
                        {
                            <li>
                                <div>
                                    <strong>@plugin.PluginId</strong>
                                    <span>@GetInstallVersionText(plugin)</span>
                                </div>
                                <span class="install-action @GetInstallActionClass(plugin.Action)">
                                    @GetInstallActionText(plugin.Action)
                                </span>
                            </li>
                        }
                    </ul>
                }

                @if (preview.Issues.Count > 0)
                {
                    <div class="install-issues">
                        <strong>@L["CompatibilityCheckFailed"]</strong>
                        <ul>
                            @foreach (var issue in preview.Issues)
                            {
                                <li>
                                    @if (!string.IsNullOrWhiteSpace(issue.PluginId))
                                    {
                                        <code>@issue.PluginId</code>
                                    }
                                    @issue.Reason
                                </li>
                            }
                        </ul>
                    </div>
                }
                else
                {
                    <p class="dialog-note">@L["YourCurrentPluginsWillBeKeptIfInstallation"]</p>
                }

                <div class="dialog-actions">
                    <button type="button" class="secondary-button" @onclick="CancelPreviewAsync">
                        @(preview.CanInstall ? L["Cancel"] : L["Close"])
                    </button>
                    @if (preview.CanInstall)
                    {
                        <button type="button"
                                class="primary-button"
                                disabled="@_isProcessing"
                                @onclick="ConfirmInstallAsync">
                            @(_isProcessing ? L["Installing"] : L["ConfirmInstall"])
                        </button>
                    }
                </div>
            </section>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_operationMessage))
    {
        <div class="global-operation-message @(_operationSucceeded ? "success" : "error")"
             role="status">
            <span>@_operationMessage</span>
            <button type="button" aria-label="@L["DismissMessage"]" @onclick="DismissMessage">×</button>
        </div>
    }
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private PluginInstallPreview? _pendingPreview;
    private string? _operationMessage;
    private bool _operationSucceeded;
    private bool _isProcessing;
    private int _fileInputKey;
    private readonly string _dropTargetId = Guid.NewGuid().ToString("N");
    private ElementReference _dropOverlay;
    private InputFile? _packageInput;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync(
                "quantum.pluginInstallerDropTarget.initialize",
                _dropTargetId,
                _dropOverlay);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync(
                "quantum.pluginInstallerDropTarget.dispose",
                _dropTargetId);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public bool IsProcessing => _isProcessing;

    public async Task ChoosePackageAsync()
    {
        if (!_isProcessing && _packageInput is not null)
        {
            await JSRuntime.InvokeVoidAsync("quantum.pluginInstallerDropTarget.choosePackage", _packageInput.Element);
        }
    }

    public async Task PrepareInstallAsync(InputFileChangeEventArgs eventArgs)
    {
        await JSRuntime.InvokeVoidAsync(
            "quantum.pluginInstallerDropTarget.hide",
            _dropTargetId);
        if (_isProcessing)
        {
            return;
        }

        _isProcessing = true;
        _operationMessage = null;
        try
        {
            var file = eventArgs.File;
            await using var stream = file.OpenReadStream(PluginPackageLimits.MaximumArchiveBytes);
            _pendingPreview = await PluginRuntimeManager.PrepareInstallAsync(stream, file.Name);
        }
        catch (Exception exception)
        {
            _operationSucceeded = false;
            _operationMessage = L["CouldNotReadPluginZIPArg", exception.Message];
        }
        finally
        {
            _isProcessing = false;
            _fileInputKey++;
        }
    }

    private async Task CancelPreviewAsync()
    {
        var preview = _pendingPreview;
        _pendingPreview = null;
        if (preview?.PreviewId is not null)
        {
            await PluginRuntimeManager.CancelInstallAsync(preview.PreviewId);
        }
    }

    private async Task ConfirmInstallAsync()
    {
        var preview = _pendingPreview;
        if (_isProcessing || preview?.PreviewId is null || !preview.CanInstall)
        {
            return;
        }

        _isProcessing = true;
        _operationMessage = null;
        try
        {
            var result = await PluginRuntimeManager.InstallAsync(preview.PreviewId);
            _operationSucceeded = result.Succeeded;
            _operationMessage = result.Message;
            _pendingPreview = null;
        }
        catch (Exception exception)
        {
            _operationSucceeded = false;
            _operationMessage = L["PluginInstallationFailedArg", exception.Message];
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void DismissMessage()
        => _operationMessage = null;

    private string GetInstallHeading(int count)
        => count == 1
            ? L["ReadyToInstallPluginSingular", count]
            : L["ReadyToInstallPluginsPlural", count];

    private string GetInstallVersionText(PluginInstallPreviewItem plugin)
        => plugin.Action switch
        {
            PluginInstallAction.Install => $"v{plugin.PackageVersion}",
            PluginInstallAction.Upgrade => $"v{plugin.InstalledVersion} → v{plugin.PackageVersion}",
            _ => L[
                "KeepVArgPackageContainsVArg",
                plugin.InstalledVersion ?? string.Empty,
                plugin.PackageVersion]
        };

    private string GetInstallActionText(PluginInstallAction action)
        => action switch
        {
            PluginInstallAction.Install => L["InstallNewPlugin"],
            PluginInstallAction.Upgrade => L["Upgrade"],
            _ => L["Skip"]
        };

    private static string GetInstallActionClass(PluginInstallAction action)
        => action switch
        {
            PluginInstallAction.Install => "new",
            PluginInstallAction.Upgrade => "upgrade",
            _ => "skip"
        };
}
