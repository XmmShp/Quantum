@inherits LayoutComponentBase
@implements IDisposable
@inject PluginCatalog PluginCatalog

<GlobalPluginInstaller>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" href="/">
                <span class="brand-mark">Q</span>
                <span>
                    <strong>Quantum</strong>
                    <small>Local plugin workspace</small>
                </span>
            </a>

            <nav aria-label="插件导航">
                @if (PluginCatalog.Routes.Count > 0)
                {
                    <p class="nav-label plugin-label">PLUGINS</p>
                    @foreach (var route in PluginCatalog.Routes)
                    {
                        <NavLink href="@route.Definition.Path" class="nav-item">
                            <span class="nav-icon">@(route.Definition.Icon ?? "◇")</span>
                            @(route.Definition.Title ?? route.PluginId.Value)
                        </NavLink>
                    }
                }
            </nav>

            <div class="sidebar-footer">
                <span class="status-dot"></span>
                @PluginCatalog.Plugins.Count 个插件已加载
            </div>
            <NavLink href="/settings" class="nav-item settings-nav-item">
                <span class="nav-icon settings-gear" aria-hidden="true">⚙</span>
                设置
            </NavLink>
        </aside>

        <main class="content">
            @Body
        </main>
    </div>
</GlobalPluginInstaller>

@code {
    protected override void OnInitialized()
    {
        PluginCatalog.Changed += OnCatalogChanged;
    }

    public void Dispose()
    {
        PluginCatalog.Changed -= OnCatalogChanged;
    }

    private void OnCatalogChanged(object? sender, EventArgs eventArgs)
    {
        _ = InvokeAsync(StateHasChanged);
    }
}
