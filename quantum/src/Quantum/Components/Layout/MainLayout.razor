@inherits LayoutComponentBase
@implements IDisposable
@inject PluginCatalog PluginCatalog

<GlobalPluginInstaller>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" href="/" aria-label="Quantum 首页" title="Quantum">
                <span class="brand-mark" aria-hidden="true">Q</span>
            </a>

            <nav aria-label="插件导航">
                @if (PluginCatalog.NavigationRoutes.Count > 0)
                {
                    @foreach (var route in PluginCatalog.NavigationRoutes)
                    {
                        var title = route.Definition.Title ?? route.PluginId.Value;
                        <NavLink href="@route.Definition.Path"
                                 class="nav-item"
                                 aria-label="@title"
                                 title="@title">
                            <span class="nav-icon" aria-hidden="true">@(route.Definition.Icon ?? "◇")</span>
                        </NavLink>
                    }
                }
            </nav>

            <NavLink href="/settings"
                     class="nav-item settings-nav-item"
                     aria-label="设置"
                     title="设置">
                <span class="nav-icon settings-gear" aria-hidden="true">⚙</span>
            </NavLink>
        </aside>

        <main class="content">
            @Body
        </main>
    </div>
</GlobalPluginInstaller>

@code {
    protected override void OnInitialized()
    {
        PluginCatalog.Changed += OnCatalogChanged;
    }

    public void Dispose()
    {
        PluginCatalog.Changed -= OnCatalogChanged;
    }

    private void OnCatalogChanged(object? sender, EventArgs eventArgs)
    {
        _ = InvokeAsync(StateHasChanged);
    }
}
