@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.Extensions.Logging
@inject PluginCatalog PluginCatalog
@inject CultureService CultureService
@inject IStringLocalizer<AppStrings> L
@inject IJSRuntime JavaScript
@inject ILogger<MainLayout> Logger

<CascadingValue Name="CultureName" Value="CultureService.CurrentCulture.Name">
    <GlobalPluginInstaller>
        <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" href="/" aria-label="@L["Quantum 首页"]" title="Quantum">
                <span class="brand-mark" aria-hidden="true">Q</span>
            </a>

            <nav aria-label="@L["插件导航"]">
                @if (PluginCatalog.NavigationRoutes.Count > 0)
                {
                    @foreach (var route in PluginCatalog.NavigationRoutes)
                    {
                        var title = route.Definition.GetTitle(CultureService.CurrentCulture)
                            ?? route.PluginId.ToString();
                        <NavLink href="@route.Definition.Path"
                                 class="nav-item"
                                 aria-label="@title"
                                 title="@title">
                            <span class="nav-icon" aria-hidden="true">@(route.Definition.Icon ?? "◇")</span>
                        </NavLink>
                    }
                }
            </nav>

            <NavLink href="/marketplace"
                     class="nav-item marketplace-nav-item"
                     aria-label="@L["插件市场"]"
                     title="@L["插件市场"]">
                <span class="nav-icon" aria-hidden="true">▦</span>
            </NavLink>

            <NavLink href="/marketplace/developer"
                     class="nav-item developer-nav-item"
                     aria-label="@L["开发者测试"]"
                     title="@L["开发者测试"]">
                <span class="nav-icon" aria-hidden="true">⌘</span>
            </NavLink>

            <NavLink href="/settings"
                     class="nav-item settings-nav-item"
                     aria-label="@L["设置"]"
                     title="@L["设置"]">
                <span class="nav-icon settings-gear" aria-hidden="true">⚙</span>
            </NavLink>
        </aside>

        <main class="content">
            @Body
        </main>
        </div>
    </GlobalPluginInstaller>
</CascadingValue>

@code {
    protected override void OnInitialized()
    {
        PluginCatalog.Changed += OnCatalogChanged;
        CultureService.Changed += OnCultureChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UpdateDocumentCultureAsync();
        }
    }

    public void Dispose()
    {
        PluginCatalog.Changed -= OnCatalogChanged;
        CultureService.Changed -= OnCultureChanged;
    }

    private void OnCatalogChanged(object? sender, EventArgs eventArgs)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnCultureChanged(object? sender, EventArgs eventArgs)
    {
        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            try
            {
                await UpdateDocumentCultureAsync();
            }
            catch (Exception exception) when (exception is JSException or TaskCanceledException or InvalidOperationException)
            {
                Logger.LogDebug(exception, "The document culture update was interrupted by a WebView reload.");
            }
        });
    }

    private ValueTask UpdateDocumentCultureAsync()
        => JavaScript.InvokeVoidAsync(
            "quantum.localization.setCulture",
            CultureService.CurrentCulture.Name,
            CultureService.TextDirection);
}
