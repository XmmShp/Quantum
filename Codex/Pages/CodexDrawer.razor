@namespace Quantum.OfficialPlugins.Codex.Pages
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using Quantum.OfficialPlugins.Codex.Application
@using Quantum.OfficialPlugins.Codex.Localization
@implements IDisposable
@inject IStringLocalizer<PluginStrings> L
@inject NavigationManager Navigation

@if (!IsOnCodexPage)
{
    <div class="floating-host" @onkeydown="HandleDrawerKeyDown">
        <button type="button"
                class="drawer-launcher"
                aria-label="@L["Open Codex"]"
                aria-expanded="@_isOpen"
                aria-controls="quantum-codex-drawer"
                @onclick="OpenDrawer">
            <span aria-hidden="true">✦</span>
            <span class="launcher-label">Codex</span>
        </button>

        @if (_isOpen)
        {
            <button type="button" class="drawer-backdrop" aria-label="@L["Close"]" @onclick="CloseDrawer"></button>
            <aside id="quantum-codex-drawer" class="drawer-panel" role="dialog" aria-modal="true" aria-label="Codex">
                <header class="drawer-header">
                    <div><span aria-hidden="true">✦</span><strong>Codex</strong></div>
                    <a href="/plugins/codex" aria-label="@L["Open Codex on its full page"]" title="@L["Open full page"]">↗</a>
                    <button type="button" autofocus aria-label="@L["Close Codex"]" @onclick="CloseDrawer">×</button>
                </header>

                <section class="drawer-shell">
                    @if (_snapshot.ErrorMessage is not null || _localError is not null)
                    {
                        <div class="drawer-error" role="alert">
                            <span>@L[_localError ?? _snapshot.ErrorMessage!]</span>
                            <button type="button" aria-label="@L["Close"]" @onclick="() => _localError = null">×</button>
                        </div>
                    }

                    @if (_snapshot.ConnectionState != CodexConnectionState.Connected)
                    {
                        <section class="drawer-connect">
                            <div class="drawer-mark" aria-hidden="true">✦</div>
                            <div>
                                <h1>@L["Connect local Codex"]</h1>
                                <p>@L["Automatically connects to local Codex. Connection errors appear here; you can retry."]</p>
                            </div>
                            <label>
                                <span>@L["Model"]</span>
                                <select @bind="_selectedModel" disabled="@IsConnecting">
                                    @foreach (var model in _snapshot.Models)
                                    {
                                        <option value="@model.Id">@model.DisplayName</option>
                                    }
                                </select>
                            </label>
                            <label>
                                <span>@L["Working directory"]</span>
                                <input @bind="_workingDirectory" disabled="@IsConnecting" />
                            </label>
                            <button type="button" class="drawer-primary" disabled="@IsConnecting" @onclick="ConnectAsync">
                                @(IsConnecting ? L["Connecting"] : L[_snapshot.ConnectionState == CodexConnectionState.Failed ? "Retry connection" : "Connect"])
                            </button>
                        </section>
                    }
                    else
                    {
                        <header class="drawer-toolbar">
                            <div class="drawer-state">
                                <span class="status-dot"></span>
                                <strong>@L["Connected"]</strong>
                                <small>@L["{0} Quantum tools", _snapshot.ToolCount]</small>
                            </div>
                            <select aria-label="@L["Model"]" value="@_selectedModel" disabled="@_snapshot.IsBusy" @onchange="ChangeModelAsync">
                                @foreach (var model in _snapshot.Models)
                                {
                                    <option value="@model.Id">@model.DisplayName</option>
                                }
                            </select>
                            <button type="button" title="@L["New conversation"]" aria-label="@L["New conversation"]" disabled="@_snapshot.IsBusy" @onclick="NewThreadAsync">＋</button>
                        </header>

                        <div class="drawer-conversation" aria-live="polite" aria-busy="@_snapshot.IsBusy">
                            @if (!_snapshot.Messages.Any(message => message.Role != CodexMessageRole.System))
                            {
                                <div class="drawer-empty">
                                    <span aria-hidden="true">✦</span>
                                    <h1>@L["Start a conversation"]</h1>
                                    <p>@L["Ask Codex to inspect your calendar, create a task, or use RPCs published by other plugins."]</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var message in _snapshot.Messages)
                                {
                                    <article @key="message.Id" class="drawer-message @message.Role.ToString().ToLowerInvariant()">
                                        <span>@L[message.Role.ToString()]</span>
                                        <div>
                                            @message.Text
                                            @if (message.IsStreaming)
                                            {
                                                <i class="drawer-cursor">▍</i>
                                            }
                                        </div>
                                    </article>
                                }
                            }
                        </div>

                        <footer class="drawer-composer">
                            <textarea rows="3"
                                      aria-label="@L["Message Codex…"]"
                                      placeholder="@L["Message Codex…"]"
                                      disabled="@_snapshot.IsBusy"
                                      @bind="_prompt"
                                      @onkeydown="HandleComposerKeyDownAsync"></textarea>
                            <button type="button" class="drawer-primary" disabled="@(!CanSend)" @onclick="SendAsync">@L["Send"] <span>↗</span></button>
                        </footer>
                    }
                </section>
            </aside>
        }
    </div>
}

@code {
    private readonly ICodexIntegrationService CodexService;
    private CodexIntegrationSnapshot _snapshot = default!;
    private string _workingDirectory = Environment.CurrentDirectory;
    private string _selectedModel = CodexIntegrationService.DefaultModel;
    private string _prompt = string.Empty;
    private string? _localError;
    private bool _isOpen;

    public CodexDrawer(ICodexIntegrationService codexService)
    {
        CodexService = codexService;
    }

    private bool IsOnCodexPage => string.Equals(
        new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/'),
        "/plugins/codex",
        StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        _snapshot = CodexService.Snapshot;
        _workingDirectory = _snapshot.WorkingDirectory;
        _selectedModel = _snapshot.SelectedModel;
        CodexService.Changed += HandleChanged;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private bool IsConnecting => _snapshot.ConnectionState == CodexConnectionState.Connecting;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await RunAsync(CodexService.EnsureAutoConnectedAsync);
    }
    private bool CanSend => !_snapshot.IsBusy && !string.IsNullOrWhiteSpace(_prompt);

    private void OpenDrawer() => _isOpen = true;
    private void CloseDrawer() => _isOpen = false;

    private void HandleDrawerKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseDrawer();
        }
    }

    private Task ConnectAsync() => RunAsync(() => CodexService.ConnectAsync(_workingDirectory, _selectedModel));
    private Task NewThreadAsync() => RunAsync(() => CodexService.StartNewThreadAsync());

    private async Task ChangeModelAsync(ChangeEventArgs args)
    {
        var model = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(model)
            || string.Equals(model, _snapshot.SelectedModel, StringComparison.Ordinal))
        {
            return;
        }

        _selectedModel = model;
        await RunAsync(() => CodexService.ChangeModelAsync(model));
    }

    private async Task SendAsync()
    {
        if (!CanSend)
        {
            return;
        }

        var prompt = _prompt;
        _prompt = string.Empty;
        await RunAsync(() => CodexService.SendAsync(prompt));
    }

    private async Task HandleComposerKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && (args.CtrlKey || args.MetaKey))
        {
            await SendAsync();
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        _localError = null;
        try
        {
            await action();
        }
        catch (Exception exception)
        {
            _localError = exception.Message;
        }
    }

    private void HandleChanged()
    {
        _snapshot = CodexService.Snapshot;
        _selectedModel = _snapshot.SelectedModel;
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _isOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CodexService.Changed -= HandleChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
