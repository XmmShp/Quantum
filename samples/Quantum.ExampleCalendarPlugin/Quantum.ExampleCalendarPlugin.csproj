<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Quantum.ExampleCalendarPlugin</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sdk\dotnet\src\Quantum.Plugin.Abstraction\Quantum.Plugin.Abstraction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="NOF.Abstraction" />
    <PackageReference Include="NOF.Application" />
    <PackageReference Include="NOF.Domain" />
    <PackageReference Include="NOF.Infrastructure" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="migrations\**\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Quantum.Tests" />
  </ItemGroup>

  <Target Name="CopyCalendarScopedCssBundle"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <CalendarScopedCssBundleSource>$(IntermediateOutputPath)scopedcss\projectbundle\$(PackageId).bundle.scp.css</CalendarScopedCssBundleSource>
      <CalendarScopedCssBundleTarget>$(TargetDir)wwwroot\$(PackageId).bundle.scp.css</CalendarScopedCssBundleTarget>
    </PropertyGroup>
    <Error Condition="!Exists('$(CalendarScopedCssBundleSource)')"
           Text="The calendar scoped CSS bundle was not generated: $(CalendarScopedCssBundleSource)" />
    <MakeDir Directories="$(TargetDir)wwwroot" />
    <Copy SourceFiles="$(CalendarScopedCssBundleSource)"
          DestinationFiles="$(CalendarScopedCssBundleTarget)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
