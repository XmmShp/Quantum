@namespace Quantum.ExampleDependentPlugin.Pages
@using Quantum.ExampleDependentPlugin
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using Quantum.ExampleDependentPlugin.Localization
@inject IStringLocalizer<PluginStrings> L

<PageTitle>@L["依赖示例"] · Quantum</PageTitle>

<section class="dependent-plugin">
    <p class="dependent-kicker">@L["REQUIRED DEPENDENCY"]</p>
    <h1>@L["先有 ExamplePlugin，才有这个页面。"]</h1>
    <p class="dependent-lead">
        <code>quantum.plugin.example-dependent</code> @L["在 manifest 中声明了强前置依赖。宿主会先校验版本并启动依赖插件；依赖缺失、版本不足或启动失败时，本插件不会加载。"]
    </p>

    <div class="dependency-flow" aria-label="@L["插件依赖加载顺序"]">
        <article>
            <span>@L["1 · REQUIRED"]</span>
            <strong>@(State.RequiredPlugin is { } requiredPlugin ? requiredPlugin.Id.ToString() : L["等待依赖"].Value)</strong>
            <p>@L["最低版本 0.1.0，当前加载版本 {0}。", State.RequiredPlugin?.Version.ToString() ?? "—"]</p>
        </article>
        <div class="dependency-arrow" aria-hidden="true">→</div>
        <article>
            <span>@L["2 · DEPENDENT"]</span>
            <strong>quantum.plugin.example-dependent</strong>
            <p>@L["启动于 {0}。", State.StartedAt?.ToString("T") ?? L["等待中"].Value]</p>
        </article>
    </div>

    <article class="dynamic-call">
        <span>@L["NAME → QUANTUM RPC"]</span>
        <code>quantum.plugin.example.example.greet</code>
        <strong>@(State.Greeting ?? L["等待调用"].Value)</strong>
        <p>
            @L["本插件只向"] <code>IRpcInvoker</code> @L["提交名称和 JSON Payload；Host 路由到"]
            <code>ExamplePlugin</code> @L["的 NOF RpcServer Handler，全程不共享服务实例或 CLR 类型。"]
        </p>
    </article>

    <p class="dependency-note">
        @L["两个插件仍处于各自独立的加载上下文；强依赖保证服务提供方先启动、后停止。"]
    </p>
</section>

@code {
    private readonly DependentPluginState State;

    public Index(DependentPluginState state)
    {
        State = state;
    }
}
