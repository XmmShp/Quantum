@namespace Quantum.ExamplePlugin.Pages
@using Quantum.ExamplePlugin
@using Microsoft.AspNetCore.Components.Web

<PageTitle>示例插件 · Quantum</PageTitle>

<section class="example-plugin">
    <p class="example-kicker">FIRST-CLASS PLUGIN</p>
    <h1>页面来自独立 DLL。</h1>
    <p class="example-lead">
        这个组件、服务、样式和脚本都由 <code>quantum.plugin.example</code> 提供，
        宿主只负责组合与受控加载。
    </p>

    <div class="example-grid">
        <article>
            <span>PLUGIN CONTAINER</span>
            <strong>DI</strong>
            <p>AutoInject 服务位于插件自己的可释放容器中。</p>
        </article>
        <article>
            <span>LOAD CONTEXT</span>
            <strong>ALC</strong>
            <p>第三方依赖在插件自己的可回收上下文中解析。</p>
        </article>
        <article>
            <span>STARTED AT</span>
            <strong>@(State.StartedAt?.ToString("HH:mm:ss") ?? "等待中")</strong>
            <p>初始化通过 NOF Initialization Step 驱动。</p>
        </article>
        <article>
            <span>WEB INTEGRATION</span>
            <strong>@(State.WebIntegrationActive ? "ACTIVE" : "STANDALONE")</strong>
            <p>与 TypeScript 示例通过弱 integration 互相发现。</p>
        </article>
        <article>
            <span>JS → .NET RPC</span>
            <strong>@State.WebHandshakeCount</strong>
            <p>
                @(State.LastWebPluginId is null
                    ? "等待 TypeScript 插件发起 FQN 调用。"
                    : $"最近调用方：{State.LastWebPluginId}")
            </p>
        </article>
    </div>
</section>

@code {
    private readonly IExamplePluginState State;

    public Index(IExamplePluginState state)
    {
        State = state;
    }
}
