<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>quantum-cli</ToolCommandName>
    <AssemblyName>quantum-cli</AssemblyName>
    <PackageId>Quantum.Platform.Cli</PackageId>
    <Version>0.1.1</Version>
    <Authors>Quantum Platform</Authors>
    <Description>Official CLI for unattended Quantum plugin publication.</Description>
    <PackageProjectUrl>https://quantum.io-vii.com</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>quantum; plugin; cli; dotnet-tool; oidc</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Quantum.Platform.Tests" />
  </ItemGroup>
</Project>
