@page "/marketplace"
@implements IAsyncDisposable
@inject IQuantumMarketplaceClient MarketplaceClient
@inject MarketplacePluginInstaller MarketplaceInstaller
@inject PluginCatalog PluginCatalog
@inject IPluginRuntimeManager PluginRuntime
@inject QuantumMarketplaceOptions MarketplaceOptions
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["PluginMarketplace"] · Quantum</PageTitle>

<section class="marketplace-page">
    <header class="marketplace-hero">
        <div>
            <h1>@L["PluginMarketplace"]</h1>
            <p>@L["FindPluginsForQuantum"]</p>
        </div>
        <div class="platform-status @(_platformReachable ? "connected" : "unavailable")">
            <img src="assets/quantum-mark.svg" alt="" />
            <span aria-hidden="true">●</span>
            <div>
                <strong>@L["QuantumPlatform"]</strong>
            </div>
        </div>
    </header>

    <div class="marketplace-toolbar">
    <nav class="marketplace-sections" aria-label="@L["MarketplaceViews"]">
        <button type="button"
                class="@(_activeArea == MarketplaceArea.Discover ? "active" : null)"
                @onclick="() => SwitchArea(MarketplaceArea.Discover)">
            <span aria-hidden="true">▦</span>
            <strong>@L["Discover"]</strong>
        </button>
        <button type="button"
                class="@(_activeArea == MarketplaceArea.DeveloperTesting ? "active" : null)"
                @onclick="() => SwitchArea(MarketplaceArea.DeveloperTesting)">
            <span aria-hidden="true">⌘</span>
            <strong>@L["MyTestReleases"]</strong>
        </button>
    </nav>
    <button type="button" class="secondary-button"
            disabled="@(PluginInstaller is null || PluginInstaller.IsProcessing)"
            @onclick="() => PluginInstaller!.ChoosePackageAsync()">
        @L["InstallFromThisDevice"]
    </button>
    </div>

    @if (_activeArea == MarketplaceArea.DeveloperTesting)
    {
        <DeveloperPortal />
    }
    else
    {
        <div class="search-panel">
        <label>
            <span class="search-icon" aria-hidden="true">⌕</span>
            <input placeholder="@L["SearchNamesIdsOrDescriptions"]"
                   maxlength="200"
                   disabled="@_isBusy"
                   @bind="_search"
                   @bind:event="oninput"
                   @onkeydown="HandleSearchKeyDown" />
        </label>
        <button type="button" class="primary-button" disabled="@_isBusy" @onclick="LoadPluginsAsync">@L["Search"]</button>
        @if (_selectedTag is not null)
        {
            <button type="button" class="tag-filter" disabled="@_isBusy" @onclick="ClearTagAsync">#@_selectedTag ×</button>
        }
        </div>

    @if (_message is not null)
    {
        <div class="market-message @(_messageIsError ? "error" : "success")" role="status">
            <span>@_message</span>
            <button type="button" aria-label="@L["DismissMessage"]" @onclick="() => _message = null">×</button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="market-state" aria-live="polite">
            <span class="spinner" aria-hidden="true"></span>
            <strong>@L["ConnectingToTheMarketplace"]</strong>
        </div>
    }
    else if (_plugins.Count == 0)
    {
        <div class="market-state">
            <span class="empty-icon" aria-hidden="true">◇</span>
            <strong>@L["NoMarketplacePluginsFound"]</strong>
            <p>@L["TryAnotherSearchClearTheTagFilterOr"]</p>
            <button type="button" class="secondary-button" disabled="@_isBusy" @onclick="LoadPluginsAsync">@L["Reload2"]</button>
        </div>
    }
    else
    {
        <div class="result-heading">
            <div>
                <p class="eyebrow">@L["DiscoverEyebrow"]</p>
                <h2>@L["ArgAvailablePlugins", _plugins.Count]</h2>
            </div>
            <button type="button" class="refresh-button" disabled="@_isBusy" @onclick="LoadPluginsAsync">↻ @L["Refresh"]</button>
        </div>

        <div class="plugin-grid">
            @foreach (var plugin in _plugins)
            {
                var installedVersion = GetInstalledVersion(plugin.PluginId);
                <article @key="plugin.PluginId" class="market-plugin-card">
                    <div class="card-topline">
                        <span class="plugin-mark">@plugin.Name[0].ToString().ToUpperInvariant()</span>
                        @if (installedVersion is not null)
                        {
                            <span class="installed-badge">✓ @L["Installed"] v@(installedVersion)</span>
                        }
                    </div>
                    <div>
                        <h3>@plugin.Name</h3>
                        <p class="plugin-id">@plugin.PluginId</p>
                    </div>
                    <p class="plugin-description">@(string.IsNullOrWhiteSpace(plugin.Description) ? L["NoDescription"] : plugin.Description)</p>
                    @if (plugin.Tags.Length > 0)
                    {
                        <div class="tag-list">
                            @foreach (var tag in plugin.Tags.Take(4))
                            {
                                <button type="button" disabled="@_isBusy" @onclick="() => FilterByTagAsync(tag)">#@tag</button>
                            }
                        </div>
                    }
                    <div class="release-line">
                        <span>@L["By"] · @plugin.AuthorName</span>
                        @if (plugin.LatestRelease is { } release)
                        {
                            <span>v@(release.Version) · @FormatSize(release.PackageSizeBytes)</span>
                        }
                    </div>
                    <div class="card-actions">
                        <button type="button" class="secondary-button" disabled="@_isBusy" @onclick="() => ShowDetailsAsync(plugin.PluginId)">@L["Details"]</button>
                        @if (plugin.LatestRelease is not null && (installedVersion is null || HasUpdate(plugin.PluginId, installedVersion)))
                        {
                            <button type="button" class="primary-button" disabled="@_isBusy" @onclick="() => PrepareMarketplaceInstallAsync(plugin)">
                                <span aria-hidden="true">↓</span>
                                @(_installingPluginId == plugin.PluginId ? L["InstallingPlugin"] : installedVersion is null ? L["DownloadAndInstall"] : L["UpdatePlugin"])
                            </button>
                        }
                    </div>
                </article>
            }
        </div>
        }
    }
</section>

@if (_details is { } details)
{
    <div class="dialog-backdrop">
        <section class="market-dialog details-dialog" role="dialog" aria-modal="true" aria-labelledby="market-details-title">
            <button type="button" class="dialog-close" aria-label="@L["Close"]" @onclick="CloseDetails">×</button>
            <p class="eyebrow">@L["PluginDetailsEyebrow"]</p>
            <h2 id="market-details-title">@details.Plugin.Name</h2>
            <p class="plugin-id">@details.Plugin.PluginId · @details.Plugin.AuthorName</p>
            <p class="details-description">@(string.IsNullOrWhiteSpace(details.Plugin.Description) ? L["NoDescription"] : details.Plugin.Description)</p>
            <h3>@L["PublishedVersions"]</h3>
            <div class="release-list">
                @foreach (var release in details.Releases)
                {
                    <article>
                        <div><strong>v@(release.Version)</strong><span>@FormatSize(release.PackageSizeBytes) · @release.DownloadCount @L["Downloads"]</span></div>
                        <p>@L["SupportsQuantumArg", release.QuantumVersionSupport]</p>
                        @if (!string.IsNullOrWhiteSpace(release.ReleaseNotes))
                        {
                            <p>@release.ReleaseNotes</p>
                        }
                    </article>
                }
            </div>
        </section>
    </div>
}

@code {
    [CascadingParameter]
    private GlobalPluginInstaller? PluginInstaller { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyList<MarketplacePlugin> _plugins = [];
    private readonly Dictionary<string, string> _availableUpdates = new(StringComparer.Ordinal);
    private MarketplacePluginDetails? _details;
    private string _search = string.Empty;
    private string? _selectedTag;
    private string? _message;
    private bool _messageIsError;
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _platformReachable;
    private string? _installingPluginId;
    private MarketplaceArea _activeArea;

    protected override Task OnInitializedAsync()
    {
        PluginCatalog.Changed += OnCatalogChanged;
        return LoadPluginsAsync();
    }

    private void OnCatalogChanged(object? sender, EventArgs eventArgs)
        => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        PluginCatalog.Changed -= OnCatalogChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private async Task LoadPluginsAsync()
    {
        if (_isBusy)
        {
            return;
        }

        _isBusy = true;
        _isLoading = true;
        _message = null;
        try
        {
            _plugins = await MarketplaceClient.ListPluginsAsync(
                _search,
                _selectedTag is null ? null : [_selectedTag],
                _lifetime.Token);
            _availableUpdates.Clear();
            foreach (var plugin in _plugins)
            {
                if (GetInstalledVersion(plugin.PluginId) is not { } installedVersion
                    || plugin.LatestRelease is not { } latest
                    || !IsNewerVersion(latest.Version, installedVersion))
                {
                    continue;
                }

                var compatibility = await MarketplaceClient.CheckCompatibilityAsync(
                    plugin.PluginId, MarketplaceOptions.QuantumVersion, _lifetime.Token);
                if (compatibility.IsCompatible && compatibility.MatchedReleaseVersion is { } version
                    && IsNewerVersion(version, installedVersion))
                {
                    _availableUpdates[plugin.PluginId] = version;
                }
            }
            _platformReachable = true;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _plugins = [];
            _platformReachable = false;
            ShowError(L["CouldNotConnectToTheMarketplaceArg", exception.Message]);
        }
        finally
        {
            _isLoading = false;
            _isBusy = false;
        }
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Enter")
        {
            await LoadPluginsAsync();
        }
    }

    private async Task FilterByTagAsync(string tag)
    {
        _selectedTag = tag;
        await LoadPluginsAsync();
    }

    private async Task ClearTagAsync()
    {
        _selectedTag = null;
        await LoadPluginsAsync();
    }

    private async Task ShowDetailsAsync(string pluginId)
    {
        await RunBusyAsync(async () =>
        {
            _details = await MarketplaceClient.GetPluginAsync(pluginId, _lifetime.Token);
        });
    }

    private void CloseDetails() => _details = null;

    private void SwitchArea(MarketplaceArea area)
    {
        _activeArea = area;
        _details = null;
    }

    private async Task PrepareMarketplaceInstallAsync(MarketplacePlugin plugin)
    {
        await RunBusyAsync(async () =>
        {
            _installingPluginId = plugin.PluginId;
            try
            {
                var result = await MarketplaceInstaller.InstallAsync(plugin, _lifetime.Token);
                _messageIsError = !result.Succeeded;
                _message = result.Message;
            }
            finally
            {
                _installingPluginId = null;
            }
        });
    }

    private async Task RunBusyAsync(Func<Task> action)
    {
        if (_isBusy)
        {
            return;
        }

        _isBusy = true;
        _message = null;
        try
        {
            await action();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            ShowError(exception.Message);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ShowError(string message)
    {
        _messageIsError = true;
        _message = message;
    }

    private string? GetInstalledVersion(string pluginId)
        => PluginCatalog.Plugins.FirstOrDefault(plugin =>
            string.Equals((string)plugin.Manifest.Id, pluginId, StringComparison.Ordinal))?.Manifest.Version.ToString()
            ?? PluginRuntime.GetDisabledPlugins().FirstOrDefault(plugin =>
                string.Equals(plugin.PluginId, pluginId, StringComparison.Ordinal))?.Version;

    private bool HasUpdate(string pluginId, string installedVersion)
        => _availableUpdates.TryGetValue(pluginId, out var version) && IsNewerVersion(version, installedVersion);

    private static bool IsNewerVersion(string candidate, string installed)
        => SemanticVersion.Of(candidate).CompareTo(SemanticVersion.Of(installed)) > 0;

    private static string FormatSize(long bytes)
        => bytes >= 1024 * 1024
            ? $"{bytes / 1024d / 1024d:0.#} MB"
            : $"{Math.Max(1, bytes / 1024d):0.#} KB";
    private enum MarketplaceArea
    {
        Discover,
        DeveloperTesting
    }
}
